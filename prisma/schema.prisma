generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAITER
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentMethod {
  CASH
  QRIS
  BANK_TRANSFER
  DEBIT
}

enum OrderStatus {
  PROCESSING
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  role         UserRole @default(CASHIER)
  active       Boolean  @default(true)
  orders       Order[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  @@map("categories")
}

model Product {
  id         Int           @id @default(autoincrement())
  categoryId Int           @map("category_id")
  category   Category      @relation(fields: [categoryId], references: [id])
  code       String        @unique
  name       String
  price      Decimal       @db.Decimal(12, 2)
  costPrice  Decimal       @default(0) @map("cost_price") @db.Decimal(12, 2)
  stock      Int           @default(0)
  minStock   Int           @default(5) @map("min_stock")
  unit       String        @default("cup")
  active     Boolean       @default(true)
  orderItems OrderDetail[]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  @@map("products")
}

model Order {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique @map("invoice_number")
  userId         Int           @map("user_id")
  user           User          @relation(fields: [userId], references: [id])
  orderType      OrderType     @map("order_type")
  tableNumber    String?       @map("table_number")
  customerName   String?       @map("customer_name")
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal       @map("grand_total") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  amountPaid     Decimal       @map("amount_paid") @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0) @map("change_amount") @db.Decimal(12, 2)
  status         OrderStatus   @default(PROCESSING)
  details        OrderDetail[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  @@index([createdAt])
  @@map("orders")
}

model OrderDetail {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int      @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity     Int
  lineSubtotal Decimal  @map("line_subtotal") @db.Decimal(12, 2)
  note         String?  @db.VarChar(255)
  @@map("order_details")
}
